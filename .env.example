# PurposeBound Treasury — all integrations are OPTIONAL.
# With none set, the app runs fully offline with deterministic, labelled
# fallbacks. Set a group to turn that integration live. Copy to .env.local.

APP_URL=http://localhost:3000

# --- Gemma 4 (Google AI Studio / Generative Language API) ---
# Key from https://aistudio.google.com/apikey  (GEMINI_API_KEY or GEMMA_API_KEY)
GEMINI_API_KEY=
# Model id goes in the request path: models/<GEMMA_MODEL>:generateContent
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Razorpay Sandbox (Test Mode) ---
# Orders work live with just the key id/secret. Route transfers also need Route
# enabled on the account. Webhook secret is only needed for /api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Route (vendor transfers) needs separate approval. Keep false until approved;
# transfers run the simulated "Demo Transfer" fallback. Flip to true when ready.
RAZORPAY_ROUTE_ENABLED=false

# --- Google Drive (OAuth 2.0) ---
# Requires GCP console setup: enable Drive API, OAuth consent screen (External +
# test users), scope drive.file, and authorised redirect URI below.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Optional on-chain anchoring (EvidenceRegistry.sol) ---
CHAIN_RPC_URL=
EVIDENCE_REGISTRY_ADDRESS=
